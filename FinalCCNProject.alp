							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[metrics.recordLatency( agent.flow_duration );
    if (dashboard != null) {
        try {
            double pred = 0.0;
            if (aiPredictor != null) {
                pred = aiPredictor.predict(new double[]{agent.packet_size, 0, 0, 0});
            }
            dashboard.addData(agent.flow_duration, pred);
        } catch (Throwable e) { 
            dashboard.logError(e.toString()); 
        }
    }

    if (dashboard != null) {
        try {
            double pred = aiPredictor.predict(new double[]{agent.packet_size, 0, 0, 0});
            dashboard.addData(agent.flow_duration, pred);
        } catch (Exception e) {}
    }
]]></Code>
							</Value>
